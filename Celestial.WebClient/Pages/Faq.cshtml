@page
@model Celestial.WebClient.Pages.FaqModel
@{
    ViewData["Title"] = L["Faq_Title"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Faq_Title"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Faq_Title"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- faq sections start -->
<div class="faq-section mb-120">
    <div class="container">
        <div class="row mb-60">
            <div class="col-lg-8 mx-auto text-center">
                <div class="section-title">
                    <h2>@L["Faq_Title"]</h2>
                    <p>@L["Faq_Subtitle"]</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                @if (Model.Faqs.HasError)
                {
                    <div class="alert alert-warning">@L["Common_Error"]</div>
                }
                else if (!Model.Faqs.Items.Any())
                {
                    <div class="alert alert-light">@L["Faq_Empty"]</div>
                }
                else
                {
                    <div class="faq-area">
                        <div class="faq-wrap style-2">
                            <div class="accordion accordion-flush" id="faqAccordion">
                                @for (var i = 0; i < Model.Faqs.Items.Count; i++)
                                {
                                    var faq = Model.Faqs.Items[i];
                                    <div class="accordion-item">
                                        <h5 class="accordion-header" id="faq-heading-@faq.Id">
                                            <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#faq-collapse-@faq.Id"
                                                    aria-expanded="@(i == 0 ? "true" : "false")"
                                                    aria-controls="faq-collapse-@faq.Id">
                                                @faq.Question
                                            </button>
                                        </h5>
                                        <div id="faq-collapse-@faq.Id"
                                             class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                                             aria-labelledby="faq-heading-@faq.Id" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body">
                                                @Html.Raw(faq.Answer)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- faq sections end -->
