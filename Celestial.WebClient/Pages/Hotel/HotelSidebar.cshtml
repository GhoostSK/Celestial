@page
@model Celestial.WebClient.Pages.Hotel.HotelSidebarModel
@{
    ViewData["Title"] = L["Hotel_ListTitle"].Value;
    var pagination = Model.Hotels.Pagination;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Hotel_ListTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Hotel_ListTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- hotel section start -->
<div class="hotel-section mb-120">
    <div class="container">
        <form method="get" id="hotel-filter-form">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="sidebar-area">
                        <div class="single-widget two mb-30">
                            <div class="search-box">
                                <input type="text" asp-for="SearchString" placeholder="@L["Common_SearchPlaceholder"]">
                                <button type="submit">@L["Common_Search"]</button>
                            </div>
                        </div>

                        <div class="single-widget mb-30">
                            <h5 class="widget-title">@L["Common_PriceFilter"]</h5>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" asp-for="FromPrice">@L["Common_From"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="FromPrice"
                                           placeholder="@Model.Hotels.MinPrice.ToString("N0")">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" asp-for="ToPrice">@L["Common_To"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="ToPrice"
                                           placeholder="@Model.Hotels.MaxPrice.ToString("N0")">
                                </div>
                            </div>
                        </div>

                        @if (Model.Hotels.CountryList.Any())
                        {
                            <div class="single-widget mb-30">
                                <h5 class="widget-title">@L["Hotel_Country"]</h5>
                                <ul>
                                    @foreach (var country in Model.Hotels.CountryList)
                                    {
                                        <li class="single-list">
                                            <div class="checkbox-item">
                                                <label>
                                                    <input type="checkbox" name="Countries" value="@country"
                                                           checked="@Model.Countries.Contains(country)">
                                                    @country
                                                </label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="single-widget mb-30">
                            <h5 class="widget-title">@L["Hotel_Location"]</h5>
                            <ul>
                                @foreach (var location in Enum.GetValues<HotelLocation>().Where(l => l != HotelLocation.None))
                                {
                                    <li class="single-list">
                                        <div class="checkbox-item">
                                            <label>
                                                <input type="checkbox" name="Locations" value="@location"
                                                       checked="@Model.Locations.Contains(location)">
                                                @L.Enum(location)
                                            </label>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="single-widget">
                            <h5 class="widget-title">@L["Hotel_Score"]</h5>
                            <ul class="review-list two">
                                @foreach (var score in Celestial.WebClient.Pages.Hotel.HotelSidebarModel.ScoreOptions)
                                {
                                    <li class="single-list">
                                        <div class="checkbox-item">
                                            <label>
                                                <input type="checkbox" name="Scores" value="@score"
                                                       checked="@Model.Scores.Contains(score)">
                                                <div class="star">
                                                    <div class="start-area">
                                                        @for (var i = 0; i < score; i++)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                    </div>
                                                    <span>(@score @L.Plural(score, "Common_Star", "Common_Stars"))</span>
                                                </div>
                                            </label>
                                        </div>
                                    </li>
                                }
                            </ul>
                            <button type="submit" class="primary-btn w-100 mt-3">@L["Common_ApplyFilter"]</button>
                            <a asp-page="/Hotel/HotelSidebar" class="view-btn three mt-3 d-inline-block">
                                <span>@L["Common_ClearFilter"]</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-4 mb-50">
                        <div class="package-inner-title-section">
                            <p>@string.Format(L["Common_Showing"].Value, Model.Hotels.Items.Count, pagination.TotalRecords)</p>
                        </div>

                        @if (Model.Hotels.HasError)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">@L["Common_Error"]</div>
                            </div>
                        }
                        else if (!Model.Hotels.Items.Any())
                        {
                            <div class="col-12">
                                <div class="alert alert-light mb-0">@L["Hotel_NotFound"]</div>
                            </div>
                        }
                        else
                        {
                            var delay = 200;
                            foreach (var hotel in Model.Hotels.Items)
                            {
                                <div class="col-md-6 wow animate fadeInUp" data-wow-delay="@(delay)ms" data-wow-duration="1500ms">
                                    <div class="experience-card">
                                        <div class="package-card-img-wrap">
                                            <a href="/@Model.CurrentLanguage/Hotel/HotelDetails/@hotel.Slug" class="card-img">
                                                <image path="@hotel.ImagePath" alt="@hotel.Name"/>
                                            </a>
                                            @if (hotel.HotelScore > 0)
                                            {
                                                <div class="batch">
                                                    <span class="featured">
                                                        @hotel.HotelScore @L.Plural(hotel.HotelScore, "Common_Star", "Common_Stars")
                                                    </span>
                                                </div>
                                                <div class="review">
                                                    <div class="icon">
                                                        <i class="bi bi-star-fill"></i>
                                                    </div>
                                                    <span>@hotel.HotelScore</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="package-card-content">
                                            <div class="card-content-top">
                                                <h5>
                                                    <a href="/@Model.CurrentLanguage/Hotel/HotelDetails/@hotel.Slug">@hotel.Name</a>
                                                </h5>
                                                @if (!string.IsNullOrWhiteSpace(hotel.HotelCountry))
                                                {
                                                    <div class="location">
                                                        <div class="icon">
                                                            <i class="bi bi-geo-alt"></i>
                                                        </div>
                                                        <span>@hotel.HotelCountry</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="card-content-center">
                                                <div class="price-area">
                                                    @if (!string.IsNullOrWhiteSpace(hotel.ShortText))
                                                    {
                                                        <h6>@hotel.ShortText</h6>
                                                    }
                                                </div>
                                                <a href="/@Model.CurrentLanguage/Hotel/HotelDetails/@hotel.Slug"
                                                   class="primary-btn small-black">@L["Common_ViewDetails"]</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                delay += 200;
                            }
                        }
                    </div>

                    @if (pagination.TotalPages > 1)
                    {
                        <div class="row">
                            <div class="col-md-12 wow animate fadeInUp" data-wow-delay="200ms" data-wow-duration="1500ms">
                                <nav class="inner-pagination-area">
                                    <ul class="pagination-list">
                                        @if (pagination.PrevPage != null)
                                        {
                                            <li>
                                                <a asp-page="/Hotel/HotelSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(pagination.PrevPage)">
                                                    <b class="shop-pagi-btn"><i class="bi bi-chevron-right"></i></b>
                                                </a>
                                            </li>
                                        }

                                        @for (var i = 1; i <= pagination.TotalPages; i++)
                                        {
                                            <li class="@(pagination.CurrentPage == i ? "activeli" : "")">
                                                <a asp-page="/Hotel/HotelSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(i)">@i</a>
                                            </li>
                                        }

                                        @if (pagination.NextPage != null)
                                        {
                                            <li>
                                                <a asp-page="/Hotel/HotelSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(pagination.NextPage)">
                                                    <b class="shop-pagi-btn"><i class="bi bi-chevron-left"></i></b>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </form>
    </div>
</div>
<!-- hotel section end -->
