@page "{slug?}"
@model Celestial.WebClient.Pages.Hotel.HotelDetailsModel
@{
    var hotel = Model.Hotel;
    ViewData["Title"] = string.IsNullOrWhiteSpace(hotel.MetaTitle) ? hotel.Name : hotel.MetaTitle;
    var pictures = hotel.HotelPictures.OrderBy(p => p.DisplayOrder).ToList();
    var mainPicture = pictures.FirstOrDefault();
}

@section Meta {
    <meta name="description" content="@hotel.MetaDescription">
    <meta name="keywords" content="@hotel.MetaKeywords">
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section three mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@(hotel.HasError ? L["Hotel_DetailsTitle"].Value : hotel.Name)</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-page="/Hotel/HotelSidebar">@L["Hotel_ListTitle"]</a>
                        </li>
                        <li class="active">@L["Hotel_DetailsTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- hotel details section start -->
<div class="package-details-section mb-120">
    <div class="container">
        @if (hotel.HasError)
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning">@L["Hotel_NotFound"]</div>
                    <a asp-page="/Hotel/HotelSidebar" class="primary-btn">@L["Hotel_ListTitle"]</a>
                </div>
            </div>
        }
        else
        {
            <div class="row gy-md-5">
                <div class="col-lg-8">
                    @if (mainPicture != null)
                    {
                        <div class="package-details-area">
                            <div class="tab-content" id="hotelGalleryContent">
                                @for (var i = 0; i < pictures.Count; i++)
                                {
                                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="hotel-image-@i" role="tabpanel">
                                        <div class="package-img">
                                            <image path="@pictures[i].PicturePath" alt="@hotel.Name"/>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (pictures.Count > 1)
                            {
                                <ul class="nav nav-tabs" id="hotelGalleryTab" role="tablist">
                                    @for (var i = 0; i < pictures.Count; i++)
                                    {
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab"
                                                    data-bs-target="#hotel-image-@i" type="button" role="tab">
                                                <image path="@pictures[i].PicturePath" alt="@hotel.Name"/>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <ul class="location-area-and-share">
                        <li class="left-side">
                            <div class="icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <span>
                                @(string.IsNullOrWhiteSpace(hotel.Address) ? hotel.HotelCountry : hotel.Address)
                                @if (!string.IsNullOrWhiteSpace(hotel.MapCoordinate))
                                {
                                    <a id="scroll-btn" href="#hotel-map">Google Map</a>
                                }
                            </span>
                        </li>
                        <li class="right-side">
                            <span>@L["Hotel_Code"]: @hotel.HotelCode</span>
                        </li>
                    </ul>

                    <ul class="feature-area-wrap">
                        <li class="single-feature">
                            <div class="icon one">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div class="content">
                                <span>@L["Common_StartingFrom"]</span>
                                <h6>@hotel.Price.ToPriceString() / <span>@L["Common_PerNight"]</span></h6>
                            </div>
                        </li>
                        <li class="single-feature">
                            <div class="icon two">
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <div class="content">
                                <span>@L["Hotel_Score"]</span>
                                <h6>@hotel.HotelScore @L.Plural(hotel.HotelScore, "Common_Star", "Common_Stars")</h6>
                            </div>
                        </li>
                        <li class="single-feature">
                            <div class="icon three">
                                <i class="bi bi-geo"></i>
                            </div>
                            <div class="content">
                                <span>@L["Hotel_Country"]</span>
                                <h6>@hotel.HotelCountry</h6>
                            </div>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(hotel.HotelReception))
                        {
                            <li class="single-feature">
                                <div class="icon four">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <div class="content">
                                    <span>@L["Hotel_Reception"]</span>
                                    <h6>@hotel.HotelReception</h6>
                                </div>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(hotel.MainText) || !string.IsNullOrWhiteSpace(hotel.ShortText))
                    {
                        <div class="overview-area">
                            <h3>@L["Hotel_About"]</h3>
                            @if (!string.IsNullOrWhiteSpace(hotel.ShortText))
                            {
                                <div class="first-paragraph">
                                    <p>@hotel.ShortText</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(hotel.MainText))
                            {
                                <div class="second-paragraph">
                                    @Html.Raw(hotel.MainText)
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(hotel.MapCoordinate))
                    {
                        <div class="overview-area" id="hotel-map">
                            <h3>@L["Hotel_Location"]</h3>
                            <iframe title="@hotel.Name" width="100%" height="350" loading="lazy"
                                    style="border:0" referrerpolicy="no-referrer-when-downgrade"
                                    src="https://www.google.com/maps?q=@hotel.MapCoordinate&output=embed"></iframe>
                        </div>
                    }

                    <!-- comments start -->
                    <div class="overview-area">
                        <h3>@L["Comment_Title"]</h3>

                        @if (!string.IsNullOrWhiteSpace(Model.CommentSuccessMessage))
                        {
                            <div class="alert alert-success">@Model.CommentSuccessMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CommentErrorMessage))
                        {
                            <div class="alert alert-warning">@Model.CommentErrorMessage</div>
                        }

                        @if (!Model.Comments.Items.Any())
                        {
                            <p>@L["Comment_Empty"]</p>
                        }
                    </div>

                    @if (Model.Comments.Items.Any())
                    {
                        <div class="comment-area">
                            @foreach (var comment in Model.Comments.Items.Where(c => c.IsConfirmed))
                            {
                                <div class="single-comment">
                                    <div class="content">
                                        <div class="top-content">
                                            <div class="author-and-star">
                                                <h5>@(string.IsNullOrWhiteSpace(comment.UserName) ? L["Comment_Guest"].Value : comment.UserName)</h5>
                                            </div>
                                            <div class="date">
                                                <span>@comment.RegisteredAt.ToLocalizedDateString()</span>
                                            </div>
                                        </div>
                                        <p>@comment.CommentText</p>

                                        @foreach (var reply in comment.Replies.Where(r => r.IsConfirmed))
                                        {
                                            <div class="single-comment two">
                                                <div class="content">
                                                    <div class="top-content">
                                                        <h5>@(string.IsNullOrWhiteSpace(reply.UserName) ? L["Comment_Guest"].Value : reply.UserName)</h5>
                                                        <div class="date">
                                                            <span>@reply.RegisteredAt.ToLocalizedDateString()</span>
                                                        </div>
                                                    </div>
                                                    <p>@reply.CommentText</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="leave-and-feedback-area">
                        <h3>@L["Comment_Leave"]</h3>
                    </div>
                    <div class="contact-form-wrapper">
                        <form method="post" asp-page-handler="AddComment" asp-route-slug="@Model.Slug">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-inner">
                                        <div class="input-area">
                                            <textarea asp-for="CommentInput.CommentText" rows="5"
                                                      placeholder="@L["Comment_Text"]"></textarea>
                                        </div>
                                        <span asp-validation-for="CommentInput.CommentText" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="primary-btn">@L["Comment_Submit"]</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- comments end -->
                </div>

                <div class="col-lg-4">
                    <div class="package-sidebar-booking-area">
                        <h4>@L["Common_BookNow"]</h4>
                        <div class="total-price">
                            <span>@L["Common_StartingFrom"]:</span>
                            @hotel.Price.ToPriceString() / @L["Common_PerNight"]
                        </div>

                        @if (!string.IsNullOrWhiteSpace(hotel.BookingUrl))
                        {
                            <a class="primary-submit eight d-block text-center" target="_blank" rel="noopener noreferrer"
                               href="@hotel.BookingUrl">@L["Hotel_BookExternal"]</a>
                        }
                        else
                        {
                            <a class="primary-submit eight d-block text-center" asp-page="/Contact">@L["Nav_Contact"]</a>
                        }
                    </div>

                    <div class="package-sidebar-booking-area mt-4">
                        <h4>@L["Hotel_About"]</h4>
                        <ul class="hightlight-area">
                            @if (!string.IsNullOrWhiteSpace(hotel.Address))
                            {
                                <li class="single-hightlight">
                                    <div class="icon">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    <span>@L["Hotel_Address"]: @hotel.Address</span>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(hotel.HotelReception))
                            {
                                <li class="single-hightlight">
                                    <div class="icon">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <span>@L["Hotel_Reception"]: @hotel.HotelReception</span>
                                </li>
                            }
                            <li class="single-hightlight">
                                <div class="icon">
                                    <i class="bi bi-upc-scan"></i>
                                </div>
                                <span>@L["Hotel_Code"]: @hotel.HotelCode</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- hotel details section end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
