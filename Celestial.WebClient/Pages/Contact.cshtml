@page
@model Celestial.WebClient.Pages.ContactModel
@{
    ViewData["Title"] = L["Contact_Title"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Contact_Title"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Contact_Title"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- contact-sections start -->
<div class="contact-section mb-120">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="contact-form-wrapper">
                    <form method="post">
                        <div class="form-title">
                            <h2>@L["Contact_Title"]</h2>
                            <p>@L["Contact_Subtitle"]</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                        {
                            <div class="alert alert-success">@Model.SuccessMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-warning">@Model.ErrorMessage</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <label asp-for="Input.Name">@L["Contact_Name"]</label>
                                    <div class="input-area">
                                        <input asp-for="Input.Name">
                                    </div>
                                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <label asp-for="Input.Email">@L["Contact_Email"]</label>
                                    <div class="input-area">
                                        <input asp-for="Input.Email" type="email">
                                    </div>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-inner">
                                    <label asp-for="Input.Message">@L["Contact_Message"]</label>
                                    <textarea asp-for="Input.Message" rows="6"></textarea>
                                    <span asp-validation-for="Input.Message" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-inner">
                                    <button class="primary-submit five" type="submit">@L["Contact_Send"]</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="contact-information">
                    <div class="single-information">
                        <h2>@L["Contact_Title"]</h2>
                        <p>@L["Contact_Subtitle"]</p>
                        <ul class="social-item-wrapper">
                            <li class="single-item one">
                                <div class="icon">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <div class="content">
                                    <h3>@L["Account_PhoneNumber"]</h3>
                                    <h6><a href="tel:09010000000">09010000000</a></h6>
                                </div>
                            </li>
                            <li class="single-item two">
                                <div class="icon">
                                    <i class="bi bi-envelope"></i>
                                </div>
                                <div class="content">
                                    <h3>@L["Contact_Email"]</h3>
                                    <h6><a href="mailto:info@celestial.local">info@celestial.local</a></h6>
                                </div>
                            </li>
                            <li class="single-item three">
                                <div class="icon">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div class="content">
                                    <h3>@L["Hotel_Address"]</h3>
                                    <h6>@L["Contact_AddressValue"]</h6>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- contact-sections end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
