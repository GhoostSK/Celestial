@page
@model Celestial.WebClient.Pages.Visa.VisaListModel
@{
    ViewData["Title"] = L["Visa_ListTitle"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Visa_ListTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Visa_ListTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- visa section start -->
<div class="package-sidebar-section mb-120">
    <div class="container">
        @if (Model.Visas.HasError)
        {
            <div class="alert alert-warning">@L["Common_Error"]</div>
        }
        else if (!Model.Visas.Items.Any())
        {
            <div class="alert alert-light">@L["Visa_NotFound"]</div>
        }
        else
        {
            <div class="row g-4">
                @{ var delay = 200; }
                @foreach (var visa in Model.Visas.Items)
                {
                    <div class="col-lg-4 col-md-6 wow animate fadeInUp"
                         data-wow-delay="@(delay)ms" data-wow-duration="1500ms">
                        <div class="package-card visa-card @(visa.Status ? "" : "is-inactive")">
                            <div class="package-card-img-wrap">
                                <a href="/@Model.CurrentLanguage/Visa/VisaDetails/@visa.Slug" class="card-img">
                                    <image path="@visa.PicturePath" alt="@visa.Country"/>
                                </a>
                                <div class="batch">
                                    <span class="featured">
                                        @(visa.Status ? L["Visa_Status_Available"] : L["Visa_Status_Unavailable"])
                                    </span>
                                </div>
                            </div>
                            <div class="package-card-content visa-card-content">
                                <div class="card-content-top">
                                    <ul>
                                        <li>
                                            <div class="icon">
                                                <i class="bi bi-geo-alt"></i>
                                            </div>
                                            <span>@visa.Country</span>
                                        </li>
                                        @if (visa.IssueDate > 0)
                                        {
                                            <li>
                                                <div class="icon">
                                                    <i class="bi bi-clock"></i>
                                                </div>
                                                <span>
                                                    @visa.IssueDate @L.Plural(visa.IssueDate, "Common_Day", "Common_Days")
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                    <h5>
                                        <a href="/@Model.CurrentLanguage/Visa/VisaDetails/@visa.Slug">@visa.Name</a>
                                    </h5>
                                </div>
                                <div class="card-content-bottom">
                                    <div class="price-area">
                                        <h6>@L["Visa_Issuer"]</h6>
                                        <h5>@L.Enum(visa.VisaIssuer)</h5>
                                    </div>
                                    <a href="/@Model.CurrentLanguage/Visa/VisaDetails/@visa.Slug"
                                       class="primary-btn small">@L["Common_ViewDetails"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    delay += 200;
                }
            </div>
        }
    </div>
</div>
<!-- visa section end -->
