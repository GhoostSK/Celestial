@page
@model Celestial.WebClient.Pages.Account.LoginModel
@{
    ViewData["Title"] = L["Account_LoginTitle"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Account_LoginTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Account_LoginTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- login section start -->
<div class="login-section mb-120">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-registration-form">
                    <div class="form-title">
                        <h2>@L["Account_LoginTitle"]</h2>
                        <p>@L["Account_LoginSubtitle"]</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning">@Model.ErrorMessage</div>
                    }

                    @if (Model.RequiresPhoneConfirmation)
                    {
                        <a class="view-btn three mb-25 d-inline-block"
                           asp-page="/Account/ConfirmPhone"
                           asp-route-userName="@Model.Input.UserName">
                            <span>@L["Account_ConfirmPhoneTitle"]</span>
                        </a>
                    }

                    <form method="post">
                        <input type="hidden" asp-for="ReturnUrl"/>

                        <div class="form-inner mb-20">
                            <input asp-for="Input.UserName" placeholder="@L["Account_UserName"]">
                            <span asp-validation-for="Input.UserName" class="text-danger"></span>
                        </div>
                        <div class="form-inner mb-20">
                            <input asp-for="Input.Password" type="password" id="password" class="form-control"
                                   placeholder="@L["Account_Password"]">
                            <i class="toggle-password bi bi-eye-slash"></i>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="form-inner mb-20">
                            <label>
                                <input asp-for="Input.RememberMe" type="checkbox">
                                @L["Account_RememberMe"]
                            </label>
                        </div>

                        <button type="submit" class="login-btn mb-25">@L["Action_Login"]</button>

                        <div class="divider">
                            <span>@L["Common_Or"]</span>
                        </div>

                        <a asp-page="/Account/Register" class="view-btn three d-inline-block">
                            <span>@L["Action_Register"]</span>
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- login section end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
