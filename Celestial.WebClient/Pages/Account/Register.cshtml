@page
@model Celestial.WebClient.Pages.Account.RegisterModel
@{
    ViewData["Title"] = L["Account_RegisterTitle"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Account_RegisterTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Account_RegisterTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- registration section start -->
<div class="login-section mb-120">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="login-registration-form">
                    <div class="form-title">
                        <h2>@L["Account_RegisterTitle"]</h2>
                        <p>@L["Account_RegisterSubtitle"]</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.Name" placeholder="@L["Account_Name"]">
                                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.LastName" placeholder="@L["Account_LastName"]">
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.UserName" placeholder="@L["Account_UserName"]">
                                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.PhoneNumber" placeholder="@L["Account_PhoneNumber"]">
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.NationalCode" placeholder="@L["Account_NationalCode"]">
                                    <span asp-validation-for="Input.NationalCode" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner">
                                    <input asp-for="Input.Password" type="password" id="password"
                                           class="form-control" placeholder="@L["Account_Password"]">
                                    <i class="toggle-password bi bi-eye-slash"></i>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="login-btn mt-25 mb-25">@L["Action_Register"]</button>

                        <div class="divider">
                            <span>@L["Common_Or"]</span>
                        </div>

                        <a asp-page="/Account/Login" class="view-btn three d-inline-block">
                            <span>@L["Action_Login"]</span>
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- registration section end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
