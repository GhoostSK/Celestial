@page
@model Celestial.WebClient.Pages.Account.ConfirmPhoneModel
@{
    ViewData["Title"] = L["Account_ConfirmPhoneTitle"].Value;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Account_ConfirmPhoneTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Account_ConfirmPhoneTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- confirm phone section start -->
<div class="login-section mb-120">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-registration-form">
                    <div class="form-title">
                        <h2>@L["Account_ConfirmPhoneTitle"]</h2>
                        <p>@L["Account_ConfirmPhoneSubtitle"]</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
                    {
                        <div class="alert alert-info">@Model.InfoMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning">@Model.ErrorMessage</div>
                    }

                    <form method="post" asp-page-handler="Confirm">
                        <div class="form-inner mb-20">
                            <input asp-for="Input.UserName" placeholder="@L["Account_UserName"]">
                            <span asp-validation-for="Input.UserName" class="text-danger"></span>
                        </div>
                        <div class="form-inner mb-20">
                            <input asp-for="Input.Code" placeholder="@L["Account_ConfirmationCode"]"
                                   inputmode="numeric" maxlength="5">
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>

                        <button type="submit" class="login-btn mb-25">@L["Account_ConfirmAction"]</button>
                    </form>

                    <form method="post" asp-page-handler="SendCode">
                        <input type="hidden" asp-for="Input.UserName"/>
                        <button type="submit" class="view-btn three">
                            <span>@L["Account_ResendCode"]</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- confirm phone section end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
