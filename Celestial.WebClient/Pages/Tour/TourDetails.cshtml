@page "{slug?}"
@model Celestial.WebClient.Pages.Tour.TourDetailsModel
@{
    var tour = Model.Tour.Item;
    ViewData["Title"] = string.IsNullOrWhiteSpace(tour.MetaTitle) ? tour.Name : tour.MetaTitle;
    var galleryImages = tour.TourPlans.SelectMany(p => p.PlanPicturePath).Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
}

@section Meta {
    <meta name="description" content="@tour.MetaDescription">
    <meta name="keywords" content="@tour.MetaKeywords">
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section three mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@(Model.Tour.HasError ? L["Tour_DetailsTitle"].Value : tour.Name)</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-page="/Tour/TourSidebar">@L["Tour_ListTitle"]</a>
                        </li>
                        <li class="active">@L["Tour_DetailsTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- package details section start -->
<div class="package-details-section mb-120">
    <div class="container">
        @if (Model.Tour.HasError)
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning">@L["Tour_NotFound"]</div>
                    <a asp-page="/Tour/TourSidebar" class="primary-btn">@L["Tour_ListTitle"]</a>
                </div>
            </div>
        }
        else
        {
            <div class="row gy-md-5">
                <div class="col-lg-8">
                    <div class="package-details-area">
                        <div class="tab-content" id="tourGalleryContent">
                            <div class="tab-pane fade show active" id="tour-image-main" role="tabpanel">
                                <div class="package-img">
                                    <image path="@tour.PicturePath" alt="@tour.Name"/>
                                </div>
                            </div>
                            @for (var i = 0; i < galleryImages.Count; i++)
                            {
                                <div class="tab-pane fade" id="tour-image-@i" role="tabpanel">
                                    <div class="package-img">
                                        <image path="@galleryImages[i]" alt="@tour.Name"/>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (galleryImages.Any())
                        {
                            <ul class="nav nav-tabs" id="tourGalleryTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" data-bs-toggle="tab"
                                            data-bs-target="#tour-image-main" type="button" role="tab">
                                        <image path="@tour.PicturePath" alt="@tour.Name"/>
                                    </button>
                                </li>
                                @for (var i = 0; i < galleryImages.Count; i++)
                                {
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" data-bs-toggle="tab"
                                                data-bs-target="#tour-image-@i" type="button" role="tab">
                                            <image path="@galleryImages[i]" alt="@tour.Name"/>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <ul class="location-area-and-share">
                        <li class="left-side">
                            <div class="icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <span>@string.Join("، ", tour.Countries)</span>
                        </li>
                        <li class="right-side">
                            <span>@L["Tour_Code"]: @tour.TourCode</span>
                        </li>
                    </ul>

                    <ul class="feature-area-wrap">
                        <li class="single-feature">
                            <div class="icon one">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div class="content">
                                <span>@L["Common_StartingFrom"]</span>
                                <h6>
                                    @tour.BasePrice.ToPriceString(tour.ForeignCurrency) /
                                    <span>@L["Common_PerPerson"]</span>
                                </h6>
                            </div>
                        </li>
                        <li class="single-feature">
                            <div class="icon two">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div class="content">
                                <span>@L["Tour_StartDate"]</span>
                                <h6>@tour.StartDate.ToLocalizedDateString()</h6>
                            </div>
                        </li>
                        <li class="single-feature">
                            <div class="icon three">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="content">
                                <span>@L["Tour_Capacity"]</span>
                                <h6>@tour.PassengerCapacity</h6>
                            </div>
                        </li>
                        <li class="single-feature">
                            <div class="icon four">
                                <i class="bi bi-flag"></i>
                            </div>
                            <div class="content">
                                <span>@L["Tour_Status"]</span>
                                <h6>@L.Enum(tour.TourStatus)</h6>
                            </div>
                        </li>
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(tour.TourMainText))
                    {
                        <div class="overview-area">
                            <h3>@L["Tour_Overview"]</h3>
                            <div class="first-paragraph">
                                @Html.Raw(tour.TourMainText)
                            </div>
                        </div>
                    }

                    @if (tour.TourFacilities.Any())
                    {
                        <div class="hightlights-area">
                            <h3>@L["Tour_Facilities"]</h3>
                            <ul class="hightlight-area">
                                @foreach (var facility in tour.TourFacilities)
                                {
                                    <li class="single-hightlight">
                                        <div class="icon">
                                            <i class="bi bi-check2-circle"></i>
                                        </div>
                                        <span>@facility</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (tour.NecessaryEquipment.Any() || tour.UnNecessaryEquipment.Any())
                    {
                        <div class="included-area">
                            <h3>@L["Tour_EquipmentNecessary"] / @L["Tour_EquipmentUnNecessary"]</h3>
                            <div class="included-featured">
                                <ul class="single-success">
                                    @foreach (var equipment in tour.NecessaryEquipment)
                                    {
                                        <li class="single-item">
                                            <div class="icon">
                                                <i class="bi bi-check-lg"></i>
                                            </div>
                                            <span>@equipment.Name</span>
                                        </li>
                                    }
                                </ul>
                                <ul class="single-error">
                                    @foreach (var equipment in tour.UnNecessaryEquipment)
                                    {
                                        <li class="single-item">
                                            <div class="icon">
                                                <i class="bi bi-dash-lg"></i>
                                            </div>
                                            <span>@equipment.Name</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    @if (tour.TourPlans.Any())
                    {
                        <div class="itinerary-area">
                            <h3>@L["Tour_Plan"]</h3>
                            @if (!string.IsNullOrWhiteSpace(tour.PlanShortText))
                            {
                                <p>@tour.PlanShortText</p>
                            }
                        </div>
                        <div class="faq-wrappaer">
                            <div class="faq-area">
                                <div class="faq-wrap">
                                    <div class="accordion accordion-flush" id="tourPlanAccordion">
                                        @for (var i = 0; i < tour.TourPlans.Count; i++)
                                        {
                                            var plan = tour.TourPlans[i];
                                            <div class="accordion-item">
                                                <h5 class="accordion-header" id="plan-heading-@i">
                                                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button"
                                                            data-bs-toggle="collapse" data-bs-target="#plan-collapse-@i"
                                                            aria-expanded="@(i == 0 ? "true" : "false")"
                                                            aria-controls="plan-collapse-@i">
                                                        <span>@plan.PlanDayText</span>
                                                    </button>
                                                </h5>
                                                <div id="plan-collapse-@i"
                                                     class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                                                     aria-labelledby="plan-heading-@i" data-bs-parent="#tourPlanAccordion">
                                                    <div class="accordion-body">
                                                        @Html.Raw(plan.PlanText)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (tour.TransPorts.Any() || !string.IsNullOrWhiteSpace(tour.PrimaryTransport.AirLine))
                    {
                        <div class="overview-area transport-area">
                            <h3>@L["Tour_Transport"]</h3>

                            @if (!string.IsNullOrWhiteSpace(tour.PrimaryTransport.AirLine))
                            {
                                <div class="flight-card">
                                    <div class="flight-card-head">
                                        @if (!string.IsNullOrWhiteSpace(tour.PrimaryTransport.AirLineImagePath))
                                        {
                                            <image class="airline-logo" path="@tour.PrimaryTransport.AirLineImagePath"
                                                   alt="@tour.PrimaryTransport.AirLine"/>
                                        }
                                        else
                                        {
                                            <span class="airline-fallback"><i class="bi bi-airplane"></i></span>
                                        }
                                        <span class="airline-name">
                                            @tour.PrimaryTransport.AirLine
                                            <span class="airline-caption">@L["Tour_PrimaryTransport"]</span>
                                        </span>
                                    </div>

                                    <div class="flight-legs">
                                        @if (!string.IsNullOrWhiteSpace(tour.PrimaryTransport.LeadFlightCode))
                                        {
                                            <div class="flight-leg">
                                                <div class="leg-title">
                                                    <span>@L["Tour_FlightCodeLead"]</span>
                                                    <span class="leg-code">@tour.PrimaryTransport.LeadFlightCode</span>
                                                </div>
                                                <div class="leg-route">
                                                    <span class="leg-time">@tour.PrimaryTransport.LeadStartTime</span>
                                                    <span class="leg-path"><i class="bi bi-airplane"></i></span>
                                                    <span class="leg-time">@tour.PrimaryTransport.LeadEndTime</span>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(tour.PrimaryTransport.ReturnFlightCode))
                                        {
                                            <div class="flight-leg">
                                                <div class="leg-title">
                                                    <span>@L["Tour_FlightCodeReturn"]</span>
                                                    <span class="leg-code">@tour.PrimaryTransport.ReturnFlightCode</span>
                                                </div>
                                                <div class="leg-route">
                                                    <span class="leg-time">@tour.PrimaryTransport.ReturnStartTime</span>
                                                    <span class="leg-path"><i class="bi bi-airplane"></i></span>
                                                    <span class="leg-time">@tour.PrimaryTransport.ReturnEndTimeTime</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (tour.TransPorts.Any())
                            {
                                <ol class="journey-roadmap">
                                    @for (var i = 0; i < tour.TransPorts.Count; i++)
                                    {
                                        var transport = tour.TransPorts[i];
                                        var stepClass = i == 0
                                            ? "journey-step is-start"
                                            : i == tour.TransPorts.Count - 1
                                                ? "journey-step is-end"
                                                : "journey-step";

                                        <li class="@stepClass">
                                            <span class="step-icon">
                                                <i class="bi @transport.TransPortType.ToTransportIcon()"></i>
                                            </span>
                                            <div class="step-card">
                                                <h6>@L.Enum(transport.TransPortType)</h6>
                                                <p class="step-meta">
                                                    <span>
                                                        <i class="bi bi-calendar-event"></i>
                                                        @transport.StartTime.ToLocalizedDateString()
                                                    </span>
                                                    <span class="step-hours">
                                                        <i class="bi bi-clock"></i>
                                                        @transport.StartTime.ToString("HH:mm") – @transport.EndTime.ToString("HH:mm")
                                                    </span>
                                                </p>
                                            </div>
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                    }

                    @if (tour.Hotels.Any())
                    {
                        <div class="overview-area">
                            <h3>@L["Hotel_ListTitle"]</h3>
                            <ul class="hightlight-area">
                                @foreach (var hotel in tour.Hotels)
                                {
                                    <li class="single-hightlight">
                                        <div class="icon">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <span>
                                            @if (string.IsNullOrWhiteSpace(hotel.Slug))
                                            {
                                                @hotel.Name
                                            }
                                            else
                                            {
                                                <a href="/@Model.CurrentLanguage/Hotel/HotelDetails/@hotel.Slug">@hotel.Name</a>
                                            }
                                            @if (hotel.HotelScore > 0)
                                            {
                                                <text>
                                                    — @hotel.HotelScore @L.Plural(hotel.HotelScore, "Common_Star", "Common_Stars")
                                                </text>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(tour.ImportantTips) || !string.IsNullOrWhiteSpace(tour.TourTips))
                    {
                        <div class="overview-area">
                            <h3>@L["Tour_ImportantTips"]</h3>
                            @if (!string.IsNullOrWhiteSpace(tour.ImportantTips))
                            {
                                @Html.Raw(tour.ImportantTips)
                            }
                            @if (!string.IsNullOrWhiteSpace(tour.TourTips))
                            {
                                @Html.Raw(tour.TourTips)
                            }
                        </div>
                    }

                    <!-- comments start -->
                    <div class="overview-area">
                        <h3>@L["Comment_Title"]</h3>

                        @if (!string.IsNullOrWhiteSpace(Model.CommentSuccessMessage))
                        {
                            <div class="alert alert-success">@Model.CommentSuccessMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CommentErrorMessage))
                        {
                            <div class="alert alert-warning">@Model.CommentErrorMessage</div>
                        }

                        @if (!Model.Comments.Items.Any())
                        {
                            <p>@L["Comment_Empty"]</p>
                        }
                    </div>

                    @if (Model.Comments.Items.Any())
                    {
                        <div class="comment-area">
                            @foreach (var comment in Model.Comments.Items.Where(c => c.IsConfirmed))
                            {
                                <div class="single-comment">
                                    <div class="content">
                                        <div class="top-content">
                                            <div class="author-and-star">
                                                <h5>@(string.IsNullOrWhiteSpace(comment.UserName) ? L["Comment_Guest"].Value : comment.UserName)</h5>
                                            </div>
                                            <div class="date">
                                                <span>@comment.RegisteredAt.ToLocalizedDateString()</span>
                                            </div>
                                        </div>
                                        <p>@comment.CommentText</p>

                                        @foreach (var reply in comment.Replies.Where(r => r.IsConfirmed))
                                        {
                                            <div class="single-comment two">
                                                <div class="content">
                                                    <div class="top-content">
                                                        <h5>@(string.IsNullOrWhiteSpace(reply.UserName) ? L["Comment_Guest"].Value : reply.UserName)</h5>
                                                        <div class="date">
                                                            <span>@reply.RegisteredAt.ToLocalizedDateString()</span>
                                                        </div>
                                                    </div>
                                                    <p>@reply.CommentText</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="leave-and-feedback-area">
                        <h3>@L["Comment_Leave"]</h3>
                    </div>
                    <div class="contact-form-wrapper">
                        <form method="post" asp-page-handler="AddComment" asp-route-slug="@Model.Slug">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-inner">
                                        <div class="input-area">
                                            <textarea asp-for="CommentInput.CommentText" rows="5"
                                                      placeholder="@L["Comment_Text"]"></textarea>
                                        </div>
                                        <span asp-validation-for="CommentInput.CommentText" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="primary-btn">@L["Comment_Submit"]</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- comments end -->

                    @if (tour.SimilarTour.Any())
                    {
                        <div class="overview-area mt-5">
                            <h3>@L["Tour_SimilarTours"]</h3>
                            <div class="row g-4">
                                @foreach (var similar in tour.SimilarTour)
                                {
                                    <div class="col-md-6">
                                        <div class="package-card">
                                            <div class="package-card-img-wrap">
                                                <a href="/@Model.CurrentLanguage/Tour/TourDetails/@similar.Slug" class="card-img">
                                                    <image path="@similar.PicturePath" alt="@similar.Title"/>
                                                </a>
                                            </div>
                                            <div class="package-card-content">
                                                <div class="card-content-top">
                                                    <h5>
                                                        <a href="/@Model.CurrentLanguage/Tour/TourDetails/@similar.Slug">@similar.Title</a>
                                                    </h5>
                                                </div>
                                                <div class="card-content-bottom">
                                                    <div class="price-area">
                                                        <h6>@L["Common_StartingFrom"]</h6>
                                                        <h5>@similar.BasePrice.ToPriceString(similar.ForeignCurrency)</h5>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (tour.SimilarBlog.Any())
                    {
                        <div class="overview-area mt-5">
                            <h3>@L["Tour_RelatedBlogs"]</h3>
                            @foreach (var blog in tour.SimilarBlog)
                            {
                                <div class="recent-post-widget">
                                    <div class="recent-post-img">
                                        <a href="/@Model.CurrentLanguage/Blog/BlogDetails/@blog.Slug">
                                            <image path="@blog.PicturePath" alt="@blog.Title"/>
                                        </a>
                                    </div>
                                    <div class="recent-post-content">
                                        <a href="#">@blog.RegistrationDate.ToLocalizedDateString()</a>
                                        <h6>
                                            <a href="/@Model.CurrentLanguage/Blog/BlogDetails/@blog.Slug">@blog.Title</a>
                                        </h6>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- booking sidebar start -->
                <div class="col-lg-4">
                    <div class="package-sidebar-booking-area">
                        <h4>@L["Booking_Title"]</h4>

                        @if (!string.IsNullOrWhiteSpace(Model.BookingSuccessMessage))
                        {
                            <div class="alert alert-success">@Model.BookingSuccessMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.BookingErrorMessage))
                        {
                            <div class="alert alert-warning">@Model.BookingErrorMessage</div>
                        }

                        @if (!Model.IsBookingOpen)
                        {
                            <div class="alert alert-light mb-0">@L["Booking_Closed"]</div>
                        }
                        else
                        {
                            <div class="sidebar-booking-form">
                                <form method="post" asp-page-handler="Book" asp-route-slug="@Model.Slug">
                                    <div class="booking-form-item-type">
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.FullName">@L["Booking_FullName"]</label>
                                            <input class="form-control" asp-for="BookingInput.FullName">
                                            <span asp-validation-for="BookingInput.FullName" class="text-danger"></span>
                                        </div>
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.PhoneNumber">@L["Booking_PhoneNumber"]</label>
                                            <input class="form-control" asp-for="BookingInput.PhoneNumber">
                                            <span asp-validation-for="BookingInput.PhoneNumber" class="text-danger"></span>
                                        </div>
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.Email">@L["Booking_Email"] (@L["Common_Optional"])</label>
                                            <input class="form-control" asp-for="BookingInput.Email">
                                            <span asp-validation-for="BookingInput.Email" class="text-danger"></span>
                                        </div>
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.NationalCode">@L["Booking_NationalCode"] (@L["Common_Optional"])</label>
                                            <input class="form-control" asp-for="BookingInput.NationalCode">
                                            <span asp-validation-for="BookingInput.NationalCode" class="text-danger"></span>
                                        </div>
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.PassengerCount">@L["Booking_PassengerCount"]</label>
                                            <input class="form-control" type="number" min="1"
                                                   max="@(tour.PassengerCapacity > 0 ? tour.PassengerCapacity : 50)"
                                                   asp-for="BookingInput.PassengerCount">
                                            <span asp-validation-for="BookingInput.PassengerCount" class="text-danger"></span>
                                        </div>
                                        <div class="form-inner mb-20">
                                            <label asp-for="BookingInput.Note">@L["Booking_Note"] (@L["Common_Optional"])</label>
                                            <textarea class="form-control" rows="3" asp-for="BookingInput.Note"></textarea>
                                            <span asp-validation-for="BookingInput.Note" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="total-price">
                                        <span>@L["Booking_TotalPrice"]:</span>
                                        @tour.BasePrice.ToPriceString(tour.ForeignCurrency) / @L["Common_PerPerson"]
                                    </div>

                                    <button class="primary-submit eight" type="submit">@L["Booking_Submit"]</button>
                                </form>
                            </div>
                        }
                    </div>

                    <div class="package-sidebar-booking-area mt-4">
                        <h4>@L["Tour_Overview"]</h4>
                        <ul class="hightlight-area">
                            <li class="single-hightlight">
                                <div class="icon">
                                    <i class="bi bi-calendar-check"></i>
                                </div>
                                <span>@L["Tour_RegistrationDeadline"]: @tour.RegistrationDeadline.ToLocalizedDateString()</span>
                            </li>
                            @if (tour.DaysUntilRegistrationDeadline >= 0)
                            {
                                <li class="single-hightlight">
                                    <div class="icon">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                    <span>@string.Format(L["Tour_DaysLeft"].Value, tour.DaysUntilRegistrationDeadline)</span>
                                </li>
                            }
                            @if (tour.Score > 0)
                            {
                                <li class="single-hightlight">
                                    <div class="icon">
                                        <i class="bi bi-star-fill"></i>
                                    </div>
                                    <span>@tour.Score</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <!-- booking sidebar end -->
            </div>
        }
    </div>
</div>
<!-- package details section end -->

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
