@page
@model Celestial.WebClient.Pages.Tour.TourSidebarModel
@{
    ViewData["Title"] = L["Tour_ListTitle"].Value;
    var filters = Model.Tours.Filters;
    var pagination = Model.Tours.Pagination;
}

<!-- breadcrumb-section start -->
<div class="breadcrumb-section mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="banner-content">
                    <h1>@L["Tour_ListTitle"]</h1>
                    <ul class="breadcrumb-list">
                        <li class="breadcrumb-item">
                            <a href="/@Model.CurrentLanguage">
                                <div class="icon">
                                    <i class="bi bi-house-door"></i>
                                </div>
                                @L["Common_Home"]
                            </a>
                        </li>
                        <li class="active">@L["Tour_ListTitle"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb-section end -->

<!-- package sidebar section start -->
<div class="package-sidebar-section mb-120">
    <div class="container">
        <form method="get" id="tour-filter-form">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="sidebar-area">
                        <div class="single-widget two mb-30">
                            <div class="search-box">
                                <input type="text" asp-for="SearchString" placeholder="@L["Common_SearchPlaceholder"]">
                                <button type="submit">@L["Common_Search"]</button>
                            </div>
                        </div>

                        <div class="single-widget mb-30">
                            <h5 class="widget-title">@L["Common_PriceFilter"]</h5>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" asp-for="FromPrice">@L["Common_From"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="FromPrice"
                                           placeholder="@filters.FromPrice.ToString("N0")">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" asp-for="ToPrice">@L["Common_To"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="ToPrice"
                                           placeholder="@filters.ToPrice.ToString("N0")">
                                </div>
                            </div>
                        </div>

                        <div class="single-widget mb-30">
                            <h5 class="widget-title">@L["Tour_Duration"]</h5>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label" asp-for="FromDay">@L["Common_From"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="FromDay"
                                           placeholder="@filters.FromDay">
                                </div>
                                <div class="col-6">
                                    <label class="form-label" asp-for="ToDay">@L["Common_To"]</label>
                                    <input class="form-control" type="number" min="0" asp-for="ToDay"
                                           placeholder="@filters.ToDay">
                                </div>
                            </div>
                        </div>

                        @if (filters.Countries.Any())
                        {
                            <div class="single-widget mb-30">
                                <h5 class="widget-title">@L["Tour_Destinations"]</h5>
                                <ul>
                                    @foreach (var country in filters.Countries)
                                    {
                                        <li class="single-list">
                                            <div class="checkbox-item">
                                                <label>
                                                    <input type="checkbox" name="Countries" value="@country"
                                                           checked="@Model.Countries.Contains(country)">
                                                    @country
                                                </label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (filters.TourType.Any())
                        {
                            <div class="single-widget mb-30">
                                <h5 class="widget-title">@L["Tour_TourType"]</h5>
                                <ul>
                                    @foreach (var tourType in filters.TourType)
                                    {
                                        <li class="single-list">
                                            <div class="checkbox-item">
                                                <label>
                                                    <input type="checkbox" name="TourTypes" value="@tourType"
                                                           checked="@Model.TourTypes.Contains(tourType)">
                                                    @L.Enum(tourType)
                                                </label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (filters.TourScope.Any())
                        {
                            <div class="single-widget mb-30">
                                <h5 class="widget-title">@L["Tour_TourScope"]</h5>
                                <ul>
                                    @foreach (var scope in filters.TourScope)
                                    {
                                        <li class="single-list">
                                            <div class="checkbox-item">
                                                <label>
                                                    <input type="checkbox" name="TourScopes" value="@scope"
                                                           checked="@Model.TourScopes.Contains(scope)">
                                                    @L.Enum(scope)
                                                </label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (filters.TourContinent.Any())
                        {
                            <div class="single-widget mb-30">
                                <h5 class="widget-title">@L["Tour_Continent"]</h5>
                                <ul>
                                    @foreach (var continent in filters.TourContinent)
                                    {
                                        <li class="single-list">
                                            <div class="checkbox-item">
                                                <label>
                                                    <input type="checkbox" name="Continents" value="@continent"
                                                           checked="@Model.Continents.Contains(continent)">
                                                    @L.Enum(continent)
                                                </label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="single-widget">
                            <ul>
                                <li class="single-list">
                                    <div class="checkbox-item">
                                        <label>
                                            <input type="checkbox" asp-for="ActiveOnly">
                                            @L["Tour_ActiveOnly"]
                                        </label>
                                    </div>
                                </li>
                            </ul>
                            <button type="submit" class="primary-btn w-100 mt-3">@L["Common_ApplyFilter"]</button>
                            <a asp-page="/Tour/TourSidebar" class="view-btn three mt-3 d-inline-block">
                                <span>@L["Common_ClearFilter"]</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-4 mb-50">
                        <div class="package-inner-title-section">
                            <p>@string.Format(L["Common_Showing"].Value, Model.Tours.Items.Count, pagination.TotalRecords)</p>
                            <div class="selector-and-grid">
                                <div class="selector">
                                    <select name="SortBy" onchange="document.getElementById('tour-filter-form').submit()">
                                        @foreach (var option in Celestial.WebClient.Pages.Tour.TourSidebarModel.SortOptions)
                                        {
                                            <option value="@option.Key" selected="@(Model.SortBy == option.Key)">
                                                @L[option.Value]
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        @if (Model.Tours.HasError)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">@L["Common_Error"]</div>
                            </div>
                        }
                        else if (!Model.Tours.Items.Any())
                        {
                            <div class="col-12">
                                <div class="alert alert-light mb-0">@L["Tour_NotFound"]</div>
                            </div>
                        }
                        else
                        {
                            var delay = 200;
                            foreach (var tour in Model.Tours.Items)
                            {
                                <div class="col-md-6 wow animate fadeInUp" data-wow-delay="@(delay)ms" data-wow-duration="1500ms">
                                    <div class="package-card">
                                        <div class="package-card-img-wrap">
                                            <a href="/@Model.CurrentLanguage/Tour/TourDetails/@tour.Slug" class="card-img">
                                                <image path="@tour.PicturePath" alt="@tour.Name"/>
                                            </a>
                                            <div class="batch">
                                                <span class="featured">@L.Enum(tour.TourStatus)</span>
                                            </div>
                                            @if (tour.Score > 0)
                                            {
                                                <div class="review">
                                                    <div class="icon">
                                                        <i class="bi bi-star-fill"></i>
                                                    </div>
                                                    <span>@tour.Score</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="package-card-content">
                                            <div class="card-content-top">
                                                <ul>
                                                    @if (tour.Country.Any())
                                                    {
                                                        <li>
                                                            <div class="icon">
                                                                <i class="bi bi-geo-alt"></i>
                                                            </div>
                                                            <span>@string.Join("، ", tour.Country)</span>
                                                        </li>
                                                    }
                                                    @if (tour.TotalDay > 0)
                                                    {
                                                        <li>
                                                            <div class="icon">
                                                                <i class="bi bi-clock"></i>
                                                            </div>
                                                            <span>@tour.TotalDay @L.Plural(tour.TotalDay, "Common_Day", "Common_Days")</span>
                                                        </li>
                                                    }
                                                </ul>
                                                <h5>
                                                    <a href="/@Model.CurrentLanguage/Tour/TourDetails/@tour.Slug">@tour.Name</a>
                                                </h5>
                                            </div>
                                            <div class="card-content-bottom">
                                                <div class="price-area">
                                                    <h6>@L["Common_StartingFrom"]</h6>
                                                    <h5>
                                                        @tour.BasePrice.ToPriceString(tour.ForeignCurrency)
                                                        <span>/ @L["Common_PerPerson"]</span>
                                                    </h5>
                                                </div>
                                                <a href="/@Model.CurrentLanguage/Tour/TourDetails/@tour.Slug"
                                                   class="primary-btn small">@L["Common_BookNow"]</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                delay += 200;
                            }
                        }
                    </div>

                    @if (pagination.TotalPages > 1)
                    {
                        <div class="row">
                            <div class="col-md-12 wow animate fadeInUp" data-wow-delay="200ms" data-wow-duration="1500ms">
                                <nav class="inner-pagination-area">
                                    <ul class="pagination-list">
                                        @if (pagination.PrevPage != null)
                                        {
                                            <li>
                                                <a asp-page="/Tour/TourSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(pagination.PrevPage)">
                                                    <b class="shop-pagi-btn"><i class="bi bi-chevron-right"></i></b>
                                                </a>
                                            </li>
                                        }

                                        @for (var i = 1; i <= pagination.TotalPages; i++)
                                        {
                                            <li class="@(pagination.CurrentPage == i ? "activeli" : "")">
                                                <a asp-page="/Tour/TourSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(i)">@i</a>
                                            </li>
                                        }

                                        @if (pagination.NextPage != null)
                                        {
                                            <li>
                                                <a asp-page="/Tour/TourSidebar"
                                                   asp-all-route-data="Model.BuildRouteValues(pagination.NextPage)">
                                                    <b class="shop-pagi-btn"><i class="bi bi-chevron-left"></i></b>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </form>
    </div>
</div>
<!-- package sidebar section end -->
